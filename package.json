{
  "name": "dmt-receipts-mcp",
  "version": "0.2.0",
  "description": "Local MCP server that prepares TAP/Ordinals inscription payloads for canonical AI agent memories and checks inscription content.",
  "type": "module",
  "bin": {
    "dmt-receipts-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "examples",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/canonical.test.mjs test/verify.test.mjs",
    "bench": "npm run build && node scripts/bench-prepare.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tap-protocol",
    "bitcoin",
    "ordinals",
    "inscriptions",
    "agent-memory",
    "ai-agents",
    "dmt-receipts"
  ],
  "author": "Cultura / DMT Receipts contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Colchora/dmt-receipts.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "socket.io-client": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "mcpName": "io.github.Colchora/dmt-receipts",
  "homepage": "https://misty-flame-3nw3.here.now/",
  "bugs": {
    "url": "https://github.com/Colchora/dmt-receipts/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
